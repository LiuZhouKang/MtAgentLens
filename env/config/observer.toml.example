# =============================================================================
# MtAgentLens Observer LLM — configuration template
# =============================================================================
# Copy to observer.toml (same directory) and fill in your values.
# The file is read by `ObserverLLMProvider::from_config_file`, which expects
# the flat keys below (not a [llm] table).
# =============================================================================

base_url = "https://api.deepseek.com/anthropic"
auth_token = "<set-me>"
model = "deepseek-v4-flash"
timeout_ms = 30000
max_retries = 3
