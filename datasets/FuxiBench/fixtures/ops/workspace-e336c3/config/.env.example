# Example environment overrides for the collector runtime.
# Copy to .env and edit. Every value below is a placeholder; none is a real
# credential or live endpoint.
ACME_LOG_LEVEL=info
ACME_PERSISTENCE_BATCH_SIZE=500
ACME_EVENT_QUEUE_CAPACITY=1024
ACME_SQLITE_JOURNAL_MODE=delete
ACME_SQLITE_BUSY_TIMEOUT_MS=0
ACME_PERSISTENCE_FLUSH_INTERVAL_MS=250

# Health reporter relay (placeholder host; not contacted during analysis).
ACME_HEALTH_RELAY_URL=https://relay.example.invalid/collector/health
ACME_HEALTH_RELAY_TOKEN=example-relay-token-not-real
