# Audit tooling environment template.
# Copy to .env and fill in locally; .env is never committed.
SSH_AUDIT_KNOWN_HOSTS=./ssh/known_hosts
SSH_AUDIT_SSH_CONFIG=./ssh/config
SSH_AUDIT_INVENTORY=./inventory/hosts.csv
# Report output directory; create it if it does not exist.
SSH_AUDIT_REPORT_DIR=/tmp/workspace-8371e2
SSH_AUDIT_REPORT_NAME=ssh-hygiene-report.md
SSH_AUDIT_API_TOKEN=<replace-with-token-issued-by-ops>
SSH_AUDIT_SMTP_PASSWORD=<replace-with-mail-relay-password>
SSH_AUDIT_STRICT=0
