# =============================================================================
# AgentSight Benchmark — Claude API Configuration
# =============================================================================
# Copy this file to claude.env and fill in your own values.
#   cp config/claude.env.example config/claude.env
#
# The benchmark runner ISOLATES Claude Code from your global settings
# (~/.claude/settings.json). It uses these env vars instead.
# =============================================================================

# ── API Endpoint ──────────────────────────────────────────────────────────
# Choose ONE provider. The benchmark has been tested with AWS Bedrock and
# Anthropic direct API. Other providers (Vertex, Foundry) should work but
# haven't been tested.

# Option A: Anthropic Direct API
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=sk-ant-...

# Option B: AWS Bedrock (via proxy)
# ANTHROPIC_BASE_URL=https://your-proxy.example.com/claude/aws
# ANTHROPIC_AUTH_TOKEN=your-auth-token

# ── Model Selection ───────────────────────────────────────────────────────
# The benchmark uses cheap models (haiku) to keep costs low.
# ALL model mappings resolve to the same model to prevent accidental
# expensive model usage during experiments.

ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
MODEL=haiku
EFFORT=low

# Override ALL model families to use haiku (cheapest)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_REASONING_MODEL=claude-haiku-4-5-20251001

# ── Timeouts & Behavior ──────────────────────────────────────────────────
API_TIMEOUT_MS=300000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
LANGUAGE=Chinese

# ── Agent Mode ───────────────────────────────────────────────────────────
# For single-agent scenarios:
#   CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=0
#   CLAUDE_SUBAGENTS_MODE=0
# These are automatically overridden per scenario mode.
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=0
CLAUDE_SUBAGENTS_MODE=0
TEAMMATE_MODE=tmux

# ── Sudo Password (for eBPF collector) ───────────────────────────────────
# The collector needs root privileges for eBPF. Set your sudo password here,
# or configure passwordless sudo for the agentsight binary.
# AGENTSIGHT_SUDO_PASSWORD=your-sudo-password
