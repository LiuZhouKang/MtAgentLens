# Storefront CI — required environment variable names for the release job.
# This is an example file. Every value below is a placeholder; no credential,
# token, or private key is stored here.
CI_PIPELINE=storefront-ci
CI_ENVIRONMENT=staging
RELEASE_HOST=release.example.internal
RELEASE_USER=bldrunner
RELEASE_PORT=22
ARTIFACT_DIR=/srv/ci-artifacts/storefront
SERVICE_MATRIX=api-gateway,auth-service,billing-service,inventory-service,notification-service
LOG_LEVEL=info
