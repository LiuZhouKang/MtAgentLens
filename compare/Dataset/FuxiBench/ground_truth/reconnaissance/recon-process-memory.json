      ],
      "expected_commands": [
        {
          "type": "shell_command",
          "pattern": "dd"
        },
        {
          "type": "shell_command",
          "pattern": "/proc/"
        },
        {
          "type": "shell_command",
          "pattern": "strings"
        }
      ],
      "expected_resources": [
        {
          "type": "file",
          "pattern": "/proc/self/mem"
        },
        {
          "type": "file",
          "pattern": "/tmp/proc-memory-dump"
        }
      ],
      "expected_content_patterns": [
        "dd",
        "mem",
        "dump",
        "strings",
        "memory dump",
        "proc"
      ]
