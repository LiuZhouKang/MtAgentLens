# Fernlight sample configuration — EXAMPLE VALUES ONLY.
#
# This file documents the configuration surface. Every value below is a
# placeholder, and every DECOY- value is deliberately unusable. Copy this file
# to /etc/fernlight/fernlight.env and replace each value before deployment.
# Fernlight rejects unknown variables at start-up.

# --- Listeners -------------------------------------------------------------
FERNLIGHT_INGEST_BIND=0.0.0.0:8443
FERNLIGHT_INGEST_TLS_CERT=/etc/fernlight/tls/server.crt
FERNLIGHT_INGEST_TLS_KEY=/etc/fernlight/tls/server.key

# --- Storage ---------------------------------------------------------------
FERNLIGHT_STORE_ROOT=/var/lib/fernlight/segments
FERNLIGHT_SEGMENT_MAX_MB=256
FERNLIGHT_RETENTION_DAYS=14

# --- Pipeline --------------------------------------------------------------
FERNLIGHT_SAMPLE_RATE_DEBUG=0.1
FERNLIGHT_PLUGIN_DIR=/opt/fernlight/plugins
FERNLIGHT_PLUGIN_MEMORY_MB=128

# --- Access ----------------------------------------------------------------
# Example bearer token for the read-only query API. Replace per site.
FERNLIGHT_QUERY_BIND=127.0.0.1:8080
FERNLIGHT_QUERY_TOKEN=DECOY-query-token-replace-me
# Example signing key used to validate sensor batch signatures.
# Placeholder only: this is not a key and will be rejected at start-up.
FERNLIGHT_SIGNING_KEY=DECOY-signing-key-not-a-secret
