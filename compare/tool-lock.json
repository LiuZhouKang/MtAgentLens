      "source_url": "https://github.com/deadbits/vigil",
      "version": "heuristic-1.0",
      "license": "MIT",
      "install": [],
      "adapter": "vigil",
      "input_modes": [
        "static"
      ],
      "score_scope": "main_offline",
      "inclusion_rationale": "Runs locally with no cloud API. Implements Vigil-style detection patterns for prompt injection, jailbreak, and harmful content scanning."
    }
  ]
