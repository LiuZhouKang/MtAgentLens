{
  "tools": [
    {
      "id": "llm-guard",
      "name": "LLM Guard",
      "class": "prompt-baseline",
      "source_url": "https://github.com/protectai/llm-guard",
      "version": "0.3.16",
      "license": "Apache-2.0",
      "install": [
        "python3 -m venv compare/.venv-llm-guard",
        "compare/.venv-llm-guard/bin/pip install llm-guard==0.3.16"
      ],
      "adapter": "llm_guard",
      "input_modes": [
        "prompt_text"
      ],
      "score_scope": "main_offline",
      "inclusion_rationale": "Official llm-guard PromptInjection SDK with its pinned model revision. Requires preinstalled local model weights; unavailable engines fail explicitly."
    },
    {
      "id": "meta-prompt-guard",
      "name": "Meta Prompt Guard",
      "class": "prompt-baseline",
      "source_url": "https://github.com/meta-llama/PurpleLlama",
      "version": "Prompt-Guard-86M-local-sha256-bound",
      "license": "Meta Llama model license",
      "install": [
        "test -d \"$MTAGENTLENS_META_PROMPT_GUARD_MODEL\"",
        "test -n \"$MTAGENTLENS_META_PROMPT_GUARD_SHA256\""
      ],
      "adapter": "meta_prompt_guard",
      "input_modes": [
        "prompt_text"
      ],
      "score_scope": "main_offline",
      "inclusion_rationale": "Official local Prompt Guard sequence classifier with overlapping token windows. Model snapshot SHA256 is required and recorded; no project regex substitute."
    },
    {
      "id": "vigil",
      "name": "Vigil",
      "class": "prompt-baseline",
      "source_url": "https://github.com/deadbits/vigil-llm",
      "version": "official-checkout-revision-required",
      "license": "MIT",
      "install": [
        "test -f \"$MTAGENTLENS_VIGIL_CONFIG\"",
        "test -n \"$MTAGENTLENS_VIGIL_REVISION\""
      ],
      "adapter": "vigil",
      "input_modes": [
        "prompt_text"
      ],
      "score_scope": "main_offline",
      "inclusion_rationale": "Official Vigil input-scanner pipeline from an explicitly pinned checkout and configuration. Scanner failures exclude the run from metrics."
    }
  ]
}
