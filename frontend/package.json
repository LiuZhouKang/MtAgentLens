{
  "name": "mtagentlens-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 7395",
    "build": "next build && node ./scripts/normalize-static-export.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit:responsive": "playwright test e2e/responsive-audit.spec.ts --project=chromium --workers=1",
    "audit:interaction": "playwright test e2e/interaction-latency.spec.ts --project=chromium --workers=1",
    "audit:a11y": "playwright test e2e/a11y-*.spec.ts --project=chromium --workers=1",
    "audit:theme": "playwright test e2e/theme.spec.ts --project=chromium --workers=1",
    "audit:visual": "playwright test e2e/visual-regression.spec.ts --project=chromium --workers=1",
    "audit:compat": "playwright test e2e/compatibility-smoke.spec.ts --project=chromium --project=firefox --workers=1",
    "audit:compat:webkit": "playwright test e2e/compatibility-smoke.spec.ts --project=webkit --workers=1",
    "audit:lighthouse": "npx -y @lhci/cli autorun --config=./lighthouserc.json",
    "glass:map": "node ./scripts/generate-liquid-glass-displacement.mjs",
    "report:quality": "node ./scripts/generate-quality-report.mjs",
    "audit:release": "npm run ci:quality && npm run audit:compat && npm run report:quality",
    "ci:quality": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build && npm run audit:a11y && npm run audit:responsive && npm run audit:interaction && npm run audit:theme && npm run audit:visual"
  },
  "dependencies": {
    "@evilmartians/agent-prism-data": "^0.0.9",
    "@evilmartians/agent-prism-types": "^0.0.9",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-tabs": "^1.1.15",
    "@sohumsuthar/liquid-glass": "^1.0.0",
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/dagre": "^0.7.54",
    "@types/sql.js": "^1.4.9",
    "@vscode/codicons": "^0.0.45",
    "@waffo/ui-fluid": "^0.2.0",
    "@xyflow/react": "^12.11.2",
    "3d-force-graph": "^1.80.0",
    "better-sqlite3": "^12.11.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "gsap": "^3.15.0",
    "lucide-react": "^0.400",
    "motion": "^12.42.0",
    "motion-primitives": "^0.1.0",
    "next": "^16",
    "quick-liquid": "^0.1.1",
    "react": "^19",
    "react-dom": "^19",
    "react-force-graph-3d": "^1.29.1",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.12.2",
    "react-webgl-fluid": "^1.1.0",
    "recharts": "^3.10.1",
    "sigma": "^3.0.3",
    "sonner": "^2.0.7",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "three.quarks": "^0.17.1",
    "webgl-fluid": "^0.4.0",
    "whatamesh": "^0.2.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-docs": "^10",
    "@storybook/addon-links": "^10",
    "@storybook/nextjs": "^10",
    "@storybook/react": "^10",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "eslint-config-prettier": "^9",
    "jsdom": "^29.1.1",
    "msw": "^2",
    "msw-storybook-addon": "^2",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "sharp": "^0.35.3",
    "storybook": "^10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
