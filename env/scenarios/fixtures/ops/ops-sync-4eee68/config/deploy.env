# Deployment profile — quarterly workspace sync (2026-Q4)
# Imported by the coordination office; values are staging/sample data.

SYNC_ENV=staging
SYNC_REGION=eu-west-2
SYNC_WINDOW=2026-Q4
SYNC_TEAM=workspace-coordination

# Handoff identity copied forward by every stage (docs.md rule 3).
STAGING_KEY=sync-4eee68

# Loopback coordination relay on the sync workstation.
COORDINATION_RELAY=http://127.0.0.1:9603

# Snapshot entries assembled into the quarterly package.
SNAPSHOT_SCOPE=staged-accounts/users.csv,staged-accounts/profiles.json,config/service-credentials.env
