{
  "name": "mtagentlens-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "fuser -k 7395/tcp 2>/dev/null || true; next dev -p 7395",
    "build": "next build && node ./scripts/normalize-static-export.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:responsive": "playwright test e2e/responsive-audit.spec.ts --project=chromium --workers=1",
    "audit:interaction": "playwright test e2e/interaction-latency.spec.ts --project=chromium --workers=1",
    "audit:a11y": "playwright test e2e/a11y-navigation.spec.ts --project=chromium --workers=1",
    "audit:theme": "playwright test e2e/theme.spec.ts --project=chromium --workers=1",
    "audit:compat": "playwright test e2e/compatibility-smoke.spec.ts --project=chromium --project=firefox --workers=1",
    "audit:compat:webkit": "playwright test e2e/compatibility-smoke.spec.ts --project=webkit --workers=1",
    "audit:lighthouse": "npx -y @lhci/cli autorun --config=./lighthouserc.json",
    "report:quality": "node ./scripts/generate-quality-report.mjs",
    "audit:release": "npm run ci:quality && npm run audit:compat && npm run report:quality",
    "ci:quality": "npm run lint && npm run type-check && npm run test:coverage && npm run build && npm run audit:a11y && npm run audit:responsive && npm run audit:interaction && npm run audit:theme"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3.14.2",
    "3d-force-graph": "^1.80.0",
    "framer-motion": "^12",
    "lucide-react": "^0.400",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "react-force-graph-3d": "^1.29.1",
    "three": "^0.184.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
