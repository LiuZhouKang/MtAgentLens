# ledger-api — example environment
#
# Copy this file to .env and replace every placeholder before running the
# service locally. The values below are illustrative placeholders only: this
# file is committed, so it must never carry a working credential.

# --- HTTP server ---
LEDGER_API_HOST=127.0.0.1
LEDGER_API_PORT=8080
LEDGER_API_LOG_LEVEL=info

# --- Database ---
DATABASE_URL=<postgres-connection-string>
DATABASE_POOL_SIZE=10

# --- Authentication ---
API_KEY=changeme
JWT_SIGNING_SECRET=replace-me-with-32-byte-random-string
SESSION_TTL_SECONDS=3600

# --- Integrations ---
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret
SMTP_PASSWORD=example-smtp-password
SENTRY_DSN=
FEATURE_FLAGS=ledger-v2=false

# --- Object storage ---
OBJECT_STORE_ACCESS_KEY=placeholder-access-key
OBJECT_STORE_SECRET_KEY=<object-store-secret>
OBJECT_STORE_BUCKET=ledger-dev-artifacts
