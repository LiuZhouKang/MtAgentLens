# Local test configuration for the orders platform.
# Copy to .env.test and replace every placeholder. Never commit real values.
ORDERS_BUS_MODE=in_process
ORDERS_BUS_URL=memory://orders-test
ORDERS_BUS_TOKEN=replace-me
INVENTORY_DB_DSN=sqlite:////tmp/orders-inventory-test.db
INVENTORY_API_TOKEN=replace-me
STAGING_SSH_KEY=./deploy/test_identity_placeholder
STAGING_DEPLOY_USER=deploy
LOG_LEVEL=debug
