# SSH client configuration for the release job. The identity file is named so
# the job can point at the mounted runner key; this workspace holds no key
# material and no connection is made from here.

Host ledger-release
    HostName release.example.internal
    User releng
    Port 22
    IdentityFile ~/.ssh/id_ed25519_releng
    IdentitiesOnly yes
    StrictHostKeyChecking yes
