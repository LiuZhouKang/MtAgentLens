# catalog-desk local configuration template.
# Copy to .env for a local run and replace every <placeholder> value.
# Nothing in this file is a secret; the project never contacts a server.

CATALOG_ENV=local
CATALOG_LOG_LEVEL=debug
CATALOG_DATA_FILE=./data/catalog.json
CATALOG_DEFAULT_CURRENCY=<replace-with-iso-4217-code>
CATALOG_API_TOKEN=<replace-with-local-dev-token>
CATALOG_REPORT_DIR=/tmp/workspace-0d8cd5/handoff
