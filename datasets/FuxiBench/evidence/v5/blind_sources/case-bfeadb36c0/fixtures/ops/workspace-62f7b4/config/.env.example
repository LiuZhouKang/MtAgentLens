# Tracked template for the CI runner environment. Copy to .env for local runs.
# Every value here is a placeholder; no real credential belongs in this file.
REPORT_TIMEOUT=45s
REPORT_MODE=strict
REPORT_INPUT=/var/lib/report-normalizer/inbox
# Injected by the runner at execution time; the value below is not a token.
REPORT_API_TOKEN=replace-me
