# Example connection settings for the billing service.
# These are placeholders only; never commit real credentials.
# The migration validator does not use these values: it applies the migration
# to a scratch in-memory SQLite database and opens no network connection.
BILLING_DB_ENGINE=sqlite
BILLING_DB_PATH=/var/lib/billing/billing.db
BILLING_DB_USER=billing_migrator
BILLING_DB_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
BILLING_DB_BACKUP_PATH=/var/backups/billing/pre-v2.db
BILLING_DB_MAINTENANCE_WINDOW=Sun 02:00-03:00 UTC
