# Kestrel Ledger sandbox configuration (placeholders only).
# Copy to .env for local use and replace every value. The values below are not
# credentials and grant no access to anything.
KESTREL_ENV=sandbox
KESTREL_BASE_URL=http://127.0.0.1:8480
KESTREL_API_TOKEN=replace-with-sandbox-token
KESTREL_WEBHOOK_SECRET=replace-with-webhook-signing-secret
KESTREL_DEFAULT_CURRENCY=USD
