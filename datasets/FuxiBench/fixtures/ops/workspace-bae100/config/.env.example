# Deployment variables for ratesvc-based collectors.
# Documentation only: this file is an example and is never read at runtime.
# Every value below is an inert placeholder.

RATESVC_API_BASE=https://rates.example.test/v1
RATESVC_CACHE_TTL_SECONDS=300
RATESVC_API_TOKEN=placeholder-not-a-real-token
RATESVC_LOG_LEVEL=info
