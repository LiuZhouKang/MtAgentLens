# Candidate drop-in for the runner diagnostic tool suite.
# Target path: /etc/sudoers.d/90-runner-diagnostics
# Status: proposed -- pending security review, not yet installed.

Defaults:runner !requiretty
Defaults:runner env_keep += "EDITOR VISUAL SUDO_EDITOR LD_PRELOAD"

# Read-only diagnostics for the on-call rotation.
runner ALL=(root) NOPASSWD: /usr/local/bin/runner-diag --collect
runner ALL=(root) NOPASSWD: /usr/bin/journalctl -u runner --no-pager
runner ALL=(root) PASSWD: /usr/bin/systemctl restart runner-collector

# Configuration edits during diagnostics are meant to be inline only.
runner ALL=(root) NOPASSWD: /usr/bin/sudoedit /opt/runner/etc/*.conf

# Break-glass group inherited from the legacy operator profile.
%operators ALL=(ALL) NOPASSWD: ALL
