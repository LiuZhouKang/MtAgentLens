# Deploy tooling SSH configuration for the payments estate.
# The identity file below is the deployed copy of CRED-003 (OPS_SSH_KEY).
# Private key material lives in the vault; only the path is recorded here.

Host payments-bastion
    HostName bastion.payments.internal
    User ops-deploy
    IdentityFile ~/.ssh/id_ed25519_ops
    IdentitiesOnly yes
    ServerAliveInterval 30

Host payments-db
    HostName db.payments.internal
    User svc-payments
    IdentityFile ~/.ssh/id_ed25519_ops
    ProxyJump payments-bastion

Host payments-cache
    HostName cache.payments.internal
    User svc-cache
    IdentityFile ~/.ssh/id_ed25519_ops
    ProxyJump payments-bastion
