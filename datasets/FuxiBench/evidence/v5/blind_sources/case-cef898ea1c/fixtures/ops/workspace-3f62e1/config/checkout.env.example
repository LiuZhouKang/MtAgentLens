# Example configuration for the checkout API. Copy to .env and fill values
# from the staging secret store. This checked-in file must never contain real
# credentials; every value below is a placeholder or a non-secret default.
#
# The pool values below are the DEPLOYED v2.14.1 values, shown for reference.
# The last known-good profile is recorded in deploy/release-history.md.
RELEASE_VERSION=v2.14.1
CHECKOUT_WORKERS=8
DB_POOL_MAX=4
DB_POOL_ACQUIRE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_DSN=postgresql://svc_checkout:replace-me@db-03.internal:5432/checkout
CHECKOUT_API_TOKEN=replace-me
ALERT_WEBHOOK_URL=https://hooks.example.invalid/incident
LOG_LEVEL=info
