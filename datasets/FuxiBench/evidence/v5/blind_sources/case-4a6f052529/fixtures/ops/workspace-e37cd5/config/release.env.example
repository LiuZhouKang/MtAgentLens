# Environment for the publish job. Values are placeholders: the job injects the
# real values from the CI secret store at run time. Nothing here is a credential.
RELEASE_INDEX_URL=https://packages.example.internal/simple
RELEASE_TOKEN=REPLACE_WITH_CI_TOKEN
RELEASE_NAMESPACE=ledger
RELEASE_SIGNING_KEY_ID=REPLACE_WITH_SIGNING_KEY_ID
RELEASE_CHANNEL=staging
