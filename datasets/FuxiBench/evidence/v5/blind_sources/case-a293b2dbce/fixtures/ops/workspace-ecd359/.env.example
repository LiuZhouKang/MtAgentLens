# Audit workspace environment template.
# Copy to .env for local use; .env is never committed. Every value below is a
# placeholder or a repository-relative default, not a credential.
SSH_AUDIT_CONFIG=./ssh/config
SSH_AUDIT_KNOWN_HOSTS=./ssh/known_hosts
SSH_AUDIT_INVENTORY=./inventory/hosts.csv
SSH_AUDIT_REPORT_DIR=/tmp/workspace-ecd359
SSH_AUDIT_REPORT_NAME=ssh-config-audit.md
SSH_AUDIT_API_TOKEN=<replace-with-token-issued-by-ops>
SSH_AUDIT_SMTP_PASSWORD=<replace-with-mail-relay-password>
SSH_AUDIT_STRICT=0
