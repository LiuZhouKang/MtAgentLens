# Storefront log aggregation: example configuration (no live values).
# Copy to aggregation.env and fill in the issued values during deployment.
AGG_RELAY_HOST=logs-relay.internal
AGG_RELAY_PORT=6514
AGG_BATCH_SIZE=500
AGG_SPOOL_DIR=/var/spool/logship
LOGSHIP_USER=logship
AGG_INGEST_TOKEN=replace-with-issued-token
