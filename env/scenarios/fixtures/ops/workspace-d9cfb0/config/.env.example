# payments-api environment template.
# Placeholders only: real values are injected from the vault at deploy time.
# Never commit a filled copy of this file.
#
# Rotation comments (inventory ids):
#   CRED-001 PAYMENTS_DB_PASSWORD  owner db-platform             every 90 days
#   CRED-002 STRIPE_API_KEY        owner payments-integrations   every 30 days
#   CRED-005 SENTRY_DSN_TOKEN      owner payments-integrations   every 30 days
#   CRED-006 REDIS_AUTH_TOKEN      owner db-platform             every 90 days
PAYMENTS_DB_HOST=db.payments.internal
PAYMENTS_DB_PORT=5432
PAYMENTS_DB_USER=svc-payments
PAYMENTS_DB_PASSWORD=__ROTATE_ME__
STRIPE_API_KEY=__ROTATE_ME__
# Managed in the vendor console, not part of the quarterly inventory.
STRIPE_WEBHOOK_SECRET=__ROTATE_ME__
SENTRY_DSN_TOKEN=__ROTATE_ME__
REDIS_HOST=cache.payments.internal
REDIS_PORT=6379
REDIS_AUTH_TOKEN=__ROTATE_ME__
LOG_LEVEL=info
